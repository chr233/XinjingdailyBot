{
  // 系统设置
  "System": {
    // 调试模式
    "Debug": true,
    // Swagger
    "Swagger": true,
    "Statistic": true,
    "HttpPort": 8235
  },
  // 机器人设置
  "Bot": {
    "BotToken": "5149880601:AAFIcbMcFnZ9WWGzcGM72PpOZ21rL8FdjIg",
    "Proxy": null,
    "ThrowPendingUpdates": false,
    "AutoLeaveOtherGroup": false,
    "SuperAdmins": [],
    "EnablePlanPost": false,
    "PostSecondMenu": false,
    "EnableWebPagePreview": false
  },
  // 频道设置
  "Channel": {
    "ReviewGroup": "",
    "CommentGroup": "",
    "SubGroup": "",
    "AcceptChannel": "",
    "RejectChannel": "",
    "SecondChannel": "",
    "SecondCommentGroup": ""
  },
  // 消息设置
  "Message": {
    "Start": "欢迎使用 心惊报 @xinjingdaily 专用投稿机器人",
    "Help": "发送图片/视频或者文字内容即可投稿"
  },
  // 数据库设置
  "Database": {
    "Generate": true,
    "LogSQL": false,
    "Type": "mysql",
    "Host": "localhost",
    "Port": 3306,
    "DbName": "xinjingdaily_db",
    "User": "root",
    "Password": "root",
    "TablePrefix": "xjb"
  },
  // 投稿设置
  "Post": {
    "EnablePostLimit": true,
    "DailyPaddingLimit": 5,
    "DailyReviewLimit": 5,
    "DailyPostLimit": 5,
    "RatioDivisor": 100,
    "MaxRatio": 10,
    "PureRetuens": true,
    "PureHashTag": true,
    "PureWords": "",
    "PostExpiredTime": 3
  },
  // IpInfo设置
  "IpInfo": {
    "Token": ""
  },
  // 计划任务
  "Schedule": {
    "Cron": {
      // 处理过期稿件
      "ExpiredPostTask": "0 0 0 * * ?",
      // 定时发布广告
      "PostAdvertiseTask": "0 0 9 * * ?",
      // 拒绝频道定时置顶
      "RejectChannelTask": "0 0 0 * * ?",
      // 已排期稿件定时发布
      "PlanedPostsTask": "0 0 0 * * ?",
      // 定时更新审核群审核状态
      "ReviewStatusTask": "*/30 * * * * ?"
    }
  },
  // 等级设置
  "Level": {
    // 每个通过稿件获得的经验
    "ExpPerAccept": 0.1,
    // 每个拒绝稿件获得的经验
    "ExpPerReject": 0.01,
    // 每个审核稿件获得的经验
    "ExpPerReview": 0.05,
    // 每个过期稿件获得的经验
    "ExpPerExpire": 0.01
  }
}